{
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev --open",
		"build": "xo && astro build",
		"preview": "astro preview",
		"test": "xo && astro build"
	},
	"overrides": {
		"@astrojs/markdown-remark": "^7.3.0",
		"ajv@6": "6.15.0",
		"ajv@8": "8.20.0",
		"baseline-browser-mapping": "2.11.21",
		"brace-expansion@1": "1.1.18",
		"brace-expansion@2": "2.1.4",
		"brace-expansion@5": "5.0.9",
		"browserslist": "4.28.9",
		"fast-uri": "3.1.7",
		"fflate": "0.8.3",
		"flatted": "3.4.4",
		"lodash": "4.18.1",
		"lodash-es": "4.18.1",
		"minimatch@3": "3.1.5",
		"minimatch@9": "9.0.9",
		"picomatch@2": "2.3.2",
		"postcss-selector-parser@6": "6.1.4",
		"postcss-selector-parser@7": "7.1.6",
		"serialize-javascript": "7.1.1",
		"svgo@3": "3.3.5",
		"svgo@4": "4.1.0",
		"webpack": "5.110.3",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@astrojs/markdown-remark": "^7.3.0",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astropub/md": "^1.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@typescript-eslint/parser": "^8.61.1",
		"astro": "^7.3.1",
		"astro-iconify": "^1.3.1",
		"autoprefixer": "^10.5.0",
		"cssnano": "^7.1.9",
		"eslint-plugin-astro": "^1.7.0",
		"ky": "^1.14.3",
		"limax": "^4.2.3",
		"postcss": "^8.5.10",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-custom-header-id": "^1.0.0",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"xo": "^0.59.3"
	},
	"xo": {
		"envs": [
			"es2021",
			"node",
			"browser"
		],
		"globals": [
			"Astro",
			"Fragment"
		],
		"extensions": [
			"astro"
		],
		"ignores": [
			"source/content.config.ts",
			"public/count.min.js",
			"public/pioche/**"
		],
		"overrides": [
			{
				"files": [
					"**/*.astro"
				],
				"parser": "astro-eslint-parser",
				"parserOptions": {
					"parser": "@typescript-eslint/parser"
				},
				"extraFileExtensions": [
					".astro"
				]
			}
		],
		"rules": {
			"unicorn/filename-case": "off",
			"unicorn/text-encoding-identifier-case": "off",
			"n/file-extension-in-import": "off",
			"operator-linebreak": "off",
			"jsx-quotes": [
				"error",
				"prefer-double"
			],
			"unicorn/prevent-abbreviations": "off"
		}
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.0"
	}
}
